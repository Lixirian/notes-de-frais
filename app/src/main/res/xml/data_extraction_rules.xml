<?xml version="1.0" encoding="utf-8"?>
<!--
  Sauvegardes Android 12+ (cloud et transfert d'appareil) : les dépenses et les justificatifs
  sont sauvegardés, mais jamais les secrets (jeton du relais, clés API) ni le code PIN.
  Les secrets sont de toute façon chiffrés par une clé Keystore propre à l'appareil.
-->
<data-extraction-rules>
    <!-- Les justificatifs partent en sauvegarde cloud uniquement si l'appareil chiffre de bout en bout. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="file" path="datastore/security.preferences_pb" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="file" path="datastore/security.preferences_pb" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
