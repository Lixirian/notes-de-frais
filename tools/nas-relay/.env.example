# Copier en `.env` DANS LE DOSSIER DU RELAIS SUR LE NAS, chmod 600, JAMAIS dans le dépôt.
# relayctl.sh remplit ce fichier pour vous (settoken, setrelaytoken, setmail, setpublicurl).

# 1) Token d'abonnement Claude, LONGUE DURÉE (~1 an). Générer sur le PC : `claude setup-token`,
#    puis :  claude setup-token | ssh <utilisateur>@<nas> "<dossier>/relayctl.sh settoken"
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat-REMPLACER
# Date d'expiration prévue (génération + 1 an) : alerte dans les journaux 30 jours avant.
CLAUDE_TOKEN_EXPIRES=2027-01-01

# 2) Jeton présenté par les apps (obtenu par appairage). Générer : ./relayctl.sh setrelaytoken
RELAY_TOKEN=REMPLACER

# 3) Modèle Claude Code : sonnet (défaut, rapide) ou opus (plus précis)
ANTHROPIC_MODEL=sonnet

# 4) Identité du conteneur = utilisateur propriétaire du dossier sur le NAS (id -u / id -g)
RELAY_UID=1000
RELAY_GID=100
# Port publié sur le LAN (le conteneur écoute toujours sur 8787 en interne)
RELAY_PORT=8787

# 5) Appairage : e-mail d'alerte à chaque demande d'accès (facultatif, ./relayctl.sh setmail)
#    et URL HTTPS publique du relais pour les liens Autoriser / Refuser (./relayctl.sh setpublicurl)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PAIR_MAIL_TO=
RELAY_PUBLIC_URL=

# Repli sans abonnement : une clé API (laisser vide si le token d'abonnement est renseigné)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
